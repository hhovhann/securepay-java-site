<%-- HubSpot form panel shared by Contact Us and Partners: same portal and form IDs as the current site, with an email fallback. --%>
<section class="form-panel alignwide" aria-labelledby="${sp:attr(page.form.key)}-contact-form-title"><div class="form-panel-aside"><p class="eyebrow">${sp:text(page.form.eyebrow)}</p><h2 id="${sp:attr(page.form.key)}-contact-form-title">${sp:text(page.form.title)}</h2><dl class="form-panel-contacts"><c:forEach items="${page.form.contacts}" var="contact"><div><dt>${sp:text(contact.label)}</dt><dd><c:forEach items="${contact.links}" var="link"><a href="${sp:url(link.url)}">${sp:text(link.label)}</a></c:forEach></dd></div></c:forEach></dl></div><div class="form-panel-form"><div class="hubspot-form-mount" data-securepay-hubspot-form data-portal-id="${sp:attr(page.form.hubspot.portal_id)}" data-form-id="${sp:attr(page.form.hubspot.form_id)}" data-region="${sp:attr(page.form.hubspot.region)}" data-fallback="securepay-${sp:attr(page.form.key)}-fallback"><div class="hbspt-form" id="hbspt-form-securepay-${sp:attr(page.form.key)}"></div></div><template id="securepay-${sp:attr(page.form.key)}-fallback"><p class="hubspot-load-error">${sp:text(page.form.fallback.message)}</p><form class="source-form-fields email-fallback-form" data-securepay-mailto-form data-recipient="${sp:attr(page.form.fallback.recipient)}" data-subject="${sp:attr(page.form.fallback.subject)}"><c:forEach items="${page.form.fallback.fields}" var="field"><label<c:if test="${field.wide}"> class="field-wide"</c:if>>${sp:text(field.label)}<c:choose><c:when test="${field.type eq 'textarea'}"><textarea name="${sp:attr(field.name)}"></textarea></c:when><c:otherwise><input name="${sp:attr(field.name)}" type="${sp:attr(field.type)}"<c:if test="${field.required}"> required</c:if>></c:otherwise></c:choose></label></c:forEach><div class="field-wide email-form-action"><button class="button-link" type="submit">${sp:text(page.form.fallback.submit_label)} <span aria-hidden="true">↗︎</span></button></div></form></template><noscript><p>${sp:text(page.form.noscript)}</p></noscript></div></section>
