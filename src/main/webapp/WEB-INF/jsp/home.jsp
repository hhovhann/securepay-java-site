<%@ include file="/WEB-INF/jsp/layout/top.jspf" %>
<%-- Home page. Text comes from content/pages/home.yml. --%>
<main id="main" class="layout-constrained">

<div class="group alignfull hero-wrap layout-constrained"><div class="group alignwide hero-grid layout-constrained">
<p class="eyebrow">${sp:text(page.hero.eyebrow)}</p>
<h1>${sp:text(page.hero.title)}</h1>
<p class="hero-copy">${sp:text(page.hero.text)}</p>
<div class="buttons hero-actions layout-flex"><div class="button-wrap"><a class="button" href="${sp:url(page.hero.primary_button.url)}">${sp:text(page.hero.primary_button.label)} <span aria-hidden="true">↗︎</span></a></div><div class="button-wrap is-style-outline"><a class="button" href="${sp:url(page.hero.secondary_button.url)}">${sp:text(page.hero.secondary_button.label)}</a></div></div>
<div class="hero-art" aria-label="${sp:plain(page.hero.workflow.label)}"><div class="orbit orbit-one" aria-hidden="true"></div><div class="orbit orbit-two" aria-hidden="true"></div><div class="orbit orbit-three" aria-hidden="true"></div><svg class="flow-path" viewBox="0 0 650 530" aria-hidden="true"><path id="hotel-flow-path" d="M88 126 C220 38 438 48 556 144 C632 247 554 404 393 454 C235 502 60 385 71 234 C76 180 80 150 88 126"/><circle r="8"><animateMotion dur="8s" repeatCount="indefinite"><mpath href="#hotel-flow-path"/></animateMotion></circle></svg><div class="center-mark"><span>${sp:text(page.hero.workflow.centre)}</span><small>${sp:text(page.hero.workflow.centre_caption)}</small></div><c:forEach items="${page.hero.workflow.stages}" var="stage" varStatus="s"><c:choose><c:when test="${s.index == 0}"><c:set var="slot" value="node-booking" /></c:when><c:when test="${s.index == 1}"><c:set var="slot" value="node-request" /></c:when><c:when test="${s.index == 2}"><c:set var="slot" value="node-guest" /></c:when><c:otherwise><c:set var="slot" value="node-response" /></c:otherwise></c:choose><button class="flow-node ${sp:attr(slot)}<c:if test="${s.first}"> is-active</c:if>" type="button" data-flow-step="${sp:attr(stage.step)}" aria-pressed="${s.first ? 'true' : 'false'}"><span>${sp:text(stage.label)}</span><strong>${sp:text(stage.title)}</strong><i>${sp:text(stage.icon)}</i></button></c:forEach><a class="art-caption" href="#journey">${sp:text(page.hero.workflow.caption)}<br><b>${sp:text(page.hero.workflow.caption_link)}</b></a></div>
</div></div>

<figure class="source-page-visual home-page-visual"><img src="${sp:url(page.image.src)}" alt="${sp:plain(page.image.alt)}" loading="lazy"></figure>

<section class="group alignwide proof-panel layout-constrained" aria-label="${sp:plain(page.numbers.label)}"><div class="proof-heading"><span class="eyebrow">${sp:text(page.numbers.eyebrow)}</span><span class="proof-progress" aria-hidden="true"><i></i></span></div><div class="group proof-strip"><c:forEach items="${page.numbers.items}" var="number"><div><strong class="stat-value">${sp:text(number.value)}</strong><span>${sp:text(number.label)}</span></div></c:forEach></div></section>

<section class="client-brand-strip alignwide" aria-label="${sp:plain(page.brands.label)}"><div class="brand-carousel" role="region" aria-label="${sp:plain(page.brands.carousel_label)}" tabindex="0"><div class="brand-track"><c:forEach items="${page.brands.logos}" var="logo"><div class="brand-logo"><img src="${sp:url(logo.src)}" alt="${sp:plain(logo.name)}" loading="lazy"></div></c:forEach><c:forEach items="${page.brands.logos}" var="logo"><div class="brand-logo" aria-hidden="true"><img src="${sp:url(logo.src)}" alt="" loading="lazy"></div></c:forEach></div></div></section>

<div class="group alignfull section services-section layout-constrained"><div class="group alignwide"><p class="eyebrow">${sp:text(page.services.eyebrow)}</p><h2>${sp:text(page.services.title)}</h2><p class="section-intro">${sp:text(page.services.text)}</p><div class="service-grid">
<c:forEach items="${page.services.cards}" var="card"><a class="service-card" href="${sp:url(card.url)}"><span class="card-index">${sp:text(card.number)}</span><span class="card-icon">${sp:text(card.icon)}</span><h3>${sp:text(card.title)}</h3><p>${sp:text(card.text)}</p><span class="text-link">${sp:text(card.link_label)}</span></a>
</c:forEach></div></div></div>

<div class="group alignfull section services-section layout-constrained"><div class="group alignwide"><p class="eyebrow">${sp:text(page.benefits.eyebrow)}</p><h2>${sp:text(page.benefits.title)}</h2><div class="service-grid benefit-grid"><c:forEach items="${page.benefits.cards}" var="card"><article class="service-card"><span class="card-index">${sp:text(card.label)}</span><h3>${sp:text(card.title)}</h3><p>${sp:text(card.text)}</p><ul><c:forEach items="${card.points}" var="point"><li>${sp:text(point)}</li></c:forEach></ul></article></c:forEach></div></div></div>

<div class="group alignfull dark-section layout-constrained"><div class="group alignwide dark-grid"><div><p class="eyebrow">${sp:text(page.about.eyebrow)}</p><h2>${sp:text(page.about.title)}</h2><p>${sp:text(page.about.text)}</p><a class="button-link" href="${sp:url(page.about.button.url)}">${sp:text(page.about.button.label)} <span>↗︎</span></a></div><div class="benefit-list"><c:forEach items="${page.about.items}" var="item"><article><span>${sp:text(item.number)}</span><div><h3>${sp:text(item.title)}</h3><p>${sp:text(item.text)}</p></div></article></c:forEach></div></div></div>

<div id="journey" class="group alignwide journey-section layout-constrained"><div class="journey-heading"><div><p class="eyebrow">${sp:text(page.workflow.eyebrow)}</p><h2>${sp:text(page.workflow.title)}</h2></div><p>${sp:text(page.workflow.text)}</p></div><div class="journey-steps" role="tablist" aria-label="${sp:plain(page.workflow.steps_label)}"><div class="journey-rail" aria-hidden="true"></div><c:forEach items="${page.workflow.steps}" var="step" varStatus="s"><button class="journey-step<c:if test="${s.first}"> is-active</c:if>" type="button" role="tab" aria-selected="${s.first ? 'true' : 'false'}" aria-controls="journey-detail" data-flow-step="${sp:attr(step.step)}" data-detail-title="${sp:attr(step.detail_title)}" data-detail="${sp:attr(step.detail)}"><span>${sp:text(step.number)}</span><h3>${sp:text(step.title)}</h3><p>${sp:text(step.text)}</p></button></c:forEach></div><div class="journey-detail" id="journey-detail" role="tabpanel" aria-live="polite"><strong data-flow-title>${sp:text(page.workflow.steps[0].detail_title)}</strong><p data-flow-copy>${sp:text(page.workflow.steps[0].detail)}</p></div><p class="contact-form-note">${sp:text(page.workflow.note)}</p></div>

<div class="group alignfull assistant-promo layout-constrained"><div class="group alignwide assistant-grid"><div><p class="eyebrow">${sp:text(page.guide_promo.eyebrow)}</p><h2>${sp:text(page.guide_promo.title)}</h2><p>${sp:text(page.guide_promo.text)}</p><button class="guide-launch" data-guide-open>${sp:text(page.guide_promo.button_label)} <span>↗︎</span></button></div><div class="guide-teaser"><div class="guide-avatar">S<span>✳︎</span></div><div><small>${sp:text(page.guide_promo.example.label)}</small><strong>${sp:text(page.guide_promo.example.question)}</strong><p>${sp:text(page.guide_promo.example.answer)}</p><a href="${sp:url(page.guide_promo.example.url)}">${sp:text(page.guide_promo.example.link_label)}</a></div></div></div></div>

<div class="group alignwide cta-band layout-constrained"><div><p class="eyebrow">${sp:text(page.cta.eyebrow)}</p><h2>${sp:text(page.cta.title)}</h2></div><a class="button-link" href="${sp:url(page.cta.button.url)}">${sp:text(page.cta.button.label)} <span>↗︎</span></a></div>
</main>
<%@ include file="/WEB-INF/jsp/layout/bottom.jspf" %>
